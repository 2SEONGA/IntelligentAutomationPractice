{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "처음 설치",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/setup.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "PDF 3개 검사 (키 불필요)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "run.py",
        "--mode",
        "offline",
        "--output",
        "outputs/offline",
        "--save-intermediate",
        "--verbose"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUTF8": "1"
        }
      },
      "problemMatcher": []
    }
  ]
}
